// Local demo (demo/run.sh). No apiKey here: baqueano-replay answers from demo/cassettes/demo.jsonl.
plugins {
    id 'nf-agent@0.2.0'
}
lineage.enabled = true
agent {
    runner  = 'langchain4j'
    baseUrl = System.getenv('REPLAY_BASE_URL') ?: 'http://replay:8080/v1'
}
