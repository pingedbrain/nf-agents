{
  "method": "POST",
  "path": "/v1/chat/completions",
  "body": {
    "model": "gpt-5-mini",
    "messages": [
      {
        "role": "user",
        "content": "Answer briefly: Is FASTQ binary?\n\nInput (JSON):\n\"Is FASTQ binary?\""
      }
    ],
    "stream": false,
    "response_format": {
      "type": "json_schema",
      "json_schema": {
        "name": "Output",
        "strict": true,
        "schema": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string"
            },
            "confidence": {
              "type": "number"
            }
          },
          "required": [
            "answer",
            "confidence"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
