---
import markLight from '../generated/brand/mark-light.svg?raw';
import markDark from '../generated/brand/mark-dark.svg?raw';

const base = import.meta.env.BASE_URL;
---

<header class="site-header wrap">
  <a class="brand" href={base} aria-label="baqueano home">
    <span class="brand-mark brand-mark-light" set:html={markLight} />
    <span class="brand-mark brand-mark-dark" set:html={markDark} />
    <span class="brand-name">baqueano</span>
  </a>
  <nav aria-label="Main">
    <ul class="nav-links">
      <li class="nav-section"><a href="#modules">Modules</a></li>
      <li class="nav-section"><a href="#bench">Benchmark</a></li>
      <li class="nav-section"><a href="#how">How it works</a></li>
      <li><a href={`${base}docs/`}>Docs</a></li>
    </ul>
  </nav>
  <a class="button button-secondary" href="https://github.com/pingedbrain/baqueano">GitHub</a>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    padding-block: 20px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--nf-ink);
    text-decoration: none;
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    font-weight: 500;
    font-size: 1.1875rem;
  }
  .brand-name {
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9375rem;
  }
  .nav-links a {
    color: var(--nf-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  /* Section anchors stay reachable by scrolling; on phones the header keeps one row. */
  @media (max-width: 559px) {
    .nav-section {
      display: none;
    }
  }
  .nav-links a:hover {
    color: var(--nf-ink);
  }
</style>
